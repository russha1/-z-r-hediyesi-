<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bizim Hikayemiz ❤️</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 99%, #fecfef 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #4a4a4a;
            padding: 20px;
        }

        /* Şifre Ekranı */
        #login-screen {
            background: rgba(255, 255, 255, 0.9);
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            text-align: center;
            max-width: 400px;
            width: 100%;
        }

        #login-screen h2 {
            color: #e63946;
            margin-bottom: 20px;
        }

        #login-screen input {
            width: 100%;
            padding: 12px;
            border: 2px solid #ffb703;
            border-radius: 10px;
            margin-bottom: 15px;
            font-size: 16px;
            text-align: center;
            outline: none;
        }

        #login-screen button {
            width: 100%;
            padding: 12px;
            background: #e63946;
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 16px;
            cursor: pointer;
            transition: 0.3s;
        }

        #login-screen button:hover {
            background: #d62828;
        }

        #error-msg {
            color: #d62828;
            margin-top: 10px;
            font-size: 14px;
            display: none;
        }

        /* Ana İçerik Sayfası */
        #main-content {
            display: none;
            max-width: 800px;
            width: 100%;
            background: rgba(255, 255, 255, 0.95);
            padding: 30px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
            text-align: center;
        }

        .counter-card {
            background: #ffe5ec;
            padding: 20px;
            border-radius: 15px;
            margin-bottom: 30px;
            border: 1px solid #ffb3c1;
        }

        .counter-card h3 {
            color: #fb6f92;
            font-size: 18px;
            margin-bottom: 5px;
        }

        .counter-number {
            font-size: 36px;
            font-weight: bold;
            color: #ff0054;
        }

        .poem-section {
            background: #fff0f3;
            padding: 25px;
            border-radius: 15px;
            margin-bottom: 30px;
            font-style: italic;
            line-height: 1.8;
            color: #590d22;
        }

        .gallery {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }

        .gallery img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            border-radius: 12px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            transition: transform 0.3s;
        }

        .gallery img:hover {
            transform: scale(1.05);
        }
    </style>
</head>
<body>

    <!-- Şifre Ekranı -->
    <div id="login-screen">
        <h2>🔒 Gizli Bahçe</h2>
        <p style="margin-bottom: 15px; color: #666;">Giriş yapmak için özel tarihimizi girin:</p>
        <input type="password" id="password-input" placeholder="Şifre">
        <button onclick="checkPassword()">Giriş Yap ❤️</button>
        <p id="error-msg">Hatalı şifre! Lütfen tekrar deneyin.</p>
    </div>

    <!-- Ana İçerik -->
    <div id="main-content">
        <h1 style="color: #ff0054; margin-bottom: 20px;">İyi Ki Varsın Sevgilim ❤️</h1>

        <!-- Müzik Çalar (Wegh - Muraba) -->
        <audio id="bg-music" loop>
            <source src="muraba.mp3" type="audio/mpeg">
            Tarayıcınız müzik çalmayı desteklemiyor.
        </audio>

        <!-- Gün Sayacı -->
        <div class="counter-card">
            <h3>Birlikte Geçirdiğimiz Süre</h3>
            <div id="day-counter" class="counter-number">0 gün</div>
            <p style="font-size: 12px; color: #888; margin-top: 5px;">31 Temmuz 2026'dan beri...</p>
        </div>

        <!-- Şiir Alanı -->
        <div class="poem-section">
            <h2 style="margin-bottom: 15px; font-style: normal; color: #ff0054;">Seninle Her An...</h2>
            <p>
                Zamanın nasıl geçtiğini unuttuğum bir gökyüzü gibisin,<br>
                Yanında geçen her saniye, ömrüme eklenen bir hediye.<br>
                31 Temmuz'da başlayan bu güzel hikayemizde,<br>
                Gözlerinin içinde kaybolmak en güzel manzara bana.<br><br>
                İyi ki yolun yoluma kesişti,<br>
                Seni çok seviyorum.
            </p>
        </div>

        <!-- Fotoğraf Galerisi -->
        <h2 style="color: #ff0054; margin-bottom: 15px;">Bizim Anılarımız</h2>
        <div class="gallery">
            <!-- Fotoğraflarının isimlerini resim1.jpg, resim2.jpg şeklinde değiştirebilirsin -->
            <img src="resim1.jpg" alt="Anı 1">
            <img src="resim2.jpg" alt="Anı 2">
            <img src="resim3.jpg" alt="Anı 3">
        </div>
    </div>

    <script>
        function checkPassword() {
            const input = document.getElementById('password-input').value;
            const errorMsg = document.getElementById('error-msg');
            
            // Şifre kontrolü (küçük/büyük harf veya boşluk duyarlılığını azaltmak için düzenlendi)
            if (input.trim().toLowerCase() === "31temuz" || input.trim().toLowerCase() === "31temmuz") {
                document.getElementById('login-screen').style.display = 'none';
                document.getElementById('main-content').style.display = 'block';
                
                // Şifre doğru girilince müziği başlat
                const music = document.getElementById('bg-music');
                music.play().catch(e => console.log("Müzik otomatik başlatılamadı:", e));

                // Sayacı başlat
                calculateDays();
            } else {
                errorMsg.style.display = 'block';
            }
        }

        function calculateDays() {
            const startDate = new Date("2026-07-31T00:00:00");
            const today = new Date();
            
            // İki tarih arasındaki farkı milisaniye cinsinden alıp güne çevirme
            const timeDiff = today - startDate;
            const daysDiff = Math.floor(timeDiff / (1000 * 60 * 60 * 24));
            
            document.getElementById('day-counter').innerText = daysDiff + " Gün";
        }
    </script>
</body>
</html>
